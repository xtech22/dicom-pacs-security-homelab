# Never publish raw assessment evidence
/evidence/raw/*
!/evidence/raw/.gitkeep

# Credentials / keys / env files
*.pem
*.key
*.p12
*.pfx
.env
.env.*
*.secret
*credentials*

# Packet captures are private by default
*.pcap
*.pcapng

# OS/editor artifacts
.DS_Store
Thumbs.db
*.swp
*.tmp

# Python
__pycache__/
*.pyc
.venv/
